ATMOS_PUBLIC_URL=http://localhost:8000
ATMOS_PRODUCTION=false
# Published HTML only. Use a persistent Render disk at /var/data/published in production.
ATMOS_PUBLISH_DIR=./data/published
ATMOS_MAX_PUBLICATIONS=500
ATMOS_PUBLISH_DURABLE=false
# Optional private SearXNG JSON endpoint; default uses DDGS web search.
ATMOS_SEARCH_URL=

# Cloud accounts (optional; do not commit real credentials)
ATMOS_DATABASE_URL=
ATMOS_ENCRYPTION_KEY=
ATMOS_RESEND_TEMPLATE_ID=
ATMOS_RESEND_API_KEY=
ATMOS_EMAIL_FROM=
